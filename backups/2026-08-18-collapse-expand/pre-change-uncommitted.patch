+		dimension_row.get("analysis_doctype") == "Sales Invoice Item"
+		or any(row["analysis_doctype"] == "Sales Invoice Item" for row, _ in validated_filters)
+	):
+		join_sql = join_sql_for_analysis(needs_sii=True, needs_item=False)
+	elif needs_qty:
+		join_sql = join_sql or " LEFT JOIN `tabSales Invoice Item` sii ON sii.parent = si.name "
+
+	params: list[Any] = [from_date, to_date]
+	conditions = ["si.docstatus = 1", "si.posting_date BETWEEN %s AND %s"]
