+def _query_sales_performance(
+	*,
+	company: Optional[str],
+	from_date: date,
+	to_date: date,
+	dimension_row: dict[str, Any],
+	validated_filters: list[tuple[dict[str, Any], list[Any]]],
+	limit: int,
+	order: str,
+) -> list[dict[str, Any]]:
+	value_source = dimension_row.get("value_source")
+	if value_source:
+		group_expr = group_expression_for_row(dimension_row)
